# ══════════════════════════════════════════════════════════════
#  Worker de Facebook — Variables de entorno
#  Copiar como .env.facebook-worker y completar con los mismos
#  valores que usa Oracle (del archivo .env en el servidor)
# ══════════════════════════════════════════════════════════════

# Conexión a Oracle via túnel SSH (host.docker.internal = host Windows)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@host.docker.internal:5432/POSTGRES_DB
REDIS_URL=redis://host.docker.internal:6379/0

# Mismo SECRET_KEY que usa Oracle (para que los JWT sean compatibles)
SECRET_KEY=
ALGORITHM=HS256

# Facebook
FB_COOKIES_FILE=/app/storage/fb_cookies.json
FB_LOOKBACK_DAYS=7

# NLP — usar modo API para no cargar modelos en RAM
NLP_MODE=api
GROQ_API_KEY=

# Notificaciones (mismo Telegram que Oracle)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# No necesario en el worker de Facebook, pero requerido por config.py
ENVIRONMENT=production
