# ─── Base de Datos ───────────────────────────────────────────
POSTGRES_DB=sonar_db
POSTGRES_USER=sonar_user
POSTGRES_PASSWORD=sonar_secret
DATABASE_URL=postgresql://sonar_user:sonar_secret@db:5432/sonar_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Seguridad ───────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_segura_de_64_caracteres
ALGORITHM=HS256
SESSION_TIMEOUT_MINUTES=480

# ─── Notificaciones ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── APIs de Redes Sociales ──────────────────────────────────
# Reddit (obtener en reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SONAR Monitor 1.0

# YouTube (obtener en console.cloud.google.com)
YOUTUBE_API_KEY=

# Indexor API (indexación de videos YouTube por subtítulos)
INDEXOR_API_URL=https://live.arquitectura-test.xyz
INDEXOR_API_TOKEN=

# HuggingFace (obtener en huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=

# ─── NLP ─────────────────────────────────────────────────────
# 'api'   → HuggingFace Inference API (gratis, sin RAM local) — recomendado para Railway
# 'local' → Modelos cargados en RAM (requiere 2GB+)           — recomendado para Oracle Cloud
NLP_MODE=api

# ─── Twitter / X (twscrape, sin API key) ────────────────────
# No necesita key. Las cuentas se agregan con el script:
#   docker compose exec backend python scripts/add_twitter_account.py
TWITTER_ACCOUNTS_DB=/app/storage/twscrape.db
TWITTER_LOOKBACK_DAYS=7
TWITTER_MAX_RESULTS=100

# ─── Bot Classifier ML (v2) ──────────────────────────────────
# Probabilidad mínima (0-1) para clasificar una cuenta como bot
BOT_THRESHOLD=0.7

# ─── Groq API (v2 — resúmenes diarios con Llama 3) ──────────
# Obtener gratis en: console.groq.com → API Keys
# Free tier: 14,400 tokens/min · sin límite de requests diarios
GROQ_API_KEY=
SUMMARY_MODEL=llama-3.1-8b-instant

# ─── Módulo 13 — Chat Asistente RAG ─────────────────────────
CHAT_ADVANCED_MODE=false

# ─── TikTok (worker local con IP residencial) ───────────────
# Obtener ms_token: tiktok.com → DevTools → Application → Cookies → msToken
TIKTOK_MS_TOKEN=
TIKTOK_LOOKBACK_DAYS=3
TIKTOK_MAX_RESULTS=30

# ─── Módulo 7 — Reconocimiento Visual ───────────────────────
FACE_RECOGNITION_ENABLED=false
FACE_DISTANCE_THRESHOLD=0.55

# ─── Módulo 8 — Búsqueda Inversa de Imágenes ────────────────
# Google Vision Web Detection (1 000 req/mes gratis)
# Obtener en: console.cloud.google.com → APIs → Cloud Vision API
GOOGLE_CLOUD_API_KEY=
# SauceNAO (200 búsquedas/día gratis con key, sin key el límite es muy bajo)
# Obtener en: saucenao.com/user/profile → API Key
SAUCENAO_API_KEY=
# SerpApi — habilita motor Yandex (100 búsquedas/mes en tier gratis)
# Obtener en: serpapi.com → Free Plan
SERPAPI_KEY=
# TinEye (plan de pago, opcional — dejar vacío para omitir)
TINEYE_API_KEY=

# ─── Entorno ─────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
