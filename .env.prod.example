# ══════════════════════════════════════════════════════════════
#  SONAR v2 — Variables de entorno para PRODUCCIÓN
#  Copiar este archivo como .env y completar los valores
#  NUNCA subir el .env real a GitHub
# ══════════════════════════════════════════════════════════════

# ─── Base de Datos ───────────────────────────────────────────
POSTGRES_DB=sonar_db
POSTGRES_USER=sonar_user
# CAMBIAR: usar una contraseña segura
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_SEGURA_AQUI
DATABASE_URL=postgresql://sonar_user:CAMBIAR_CONTRASENA_SEGURA_AQUI@db:5432/sonar_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Seguridad ───────────────────────────────────────────────
# CAMBIAR: generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_SECRET_KEY_AQUI
ALGORITHM=HS256
SESSION_TIMEOUT_MINUTES=480

# ─── URL pública del servidor (IP o dominio) ─────────────────
# Reemplazar con la IP pública de Oracle Cloud
VITE_API_URL=http://TU_IP_PUBLICA_ORACLE
FRONTEND_URL=http://TU_IP_PUBLICA_ORACLE

# ─── Notificaciones (completar según necesidad) ──────────────
TELEGRAM_BOT_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── APIs de Redes Sociales ───────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SONAR Monitor 2.0
YOUTUBE_API_KEY=

# ─── Indexor API ─────────────────────────────────────────────
INDEXOR_API_URL=https://live.arquitectura-test.xyz
INDEXOR_API_TOKEN=

# ─── Twitter / X ────────────────────────────────────────────
TWITTER_ACCOUNTS_DB=/app/storage/twscrape.db
TWITTER_BEARER_TOKEN=
TWITTER_LOOKBACK_DAYS=7
TWITTER_MAX_RESULTS=100

# ─── NLP ─────────────────────────────────────────────────────
NLP_MODE=api
HUGGINGFACE_TOKEN=

# ─── Groq API (Asistente IA) ─────────────────────────────────
GROQ_API_KEY=
SUMMARY_MODEL=llama-3.1-8b-instant

# ─── Módulo 13 — Chat ────────────────────────────────────────
CHAT_ADVANCED_MODE=false

# ─── Módulo 7 — Reconocimiento Visual ────────────────────────
FACE_RECOGNITION_ENABLED=false
FACE_DISTANCE_THRESHOLD=0.55

# ─── Entorno ─────────────────────────────────────────────────
ENVIRONMENT=production
